# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# SQLite by default. For Postgres install the driver first:
#   pip install "psycopg[binary]"
# then: DATABASE_URL=postgresql+psycopg://user:pass@host:5432/terminal
DATABASE_URL=sqlite:///./terminal.db

# paper = all fills simulated locally (default). live = route to exchange APIs.
TRADING_MODE=paper
MARKET_POLL_MS=1500

# ---------------------------------------------------------------------------
# Delta Exchange India  (https://docs.delta.exchange)
# Public market data needs no keys. Keys are only needed for live orders.
# Create at delta.exchange -> API Keys, enable "Trading", whitelist your IP.
# ---------------------------------------------------------------------------
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_API_KEY=
DELTA_API_SECRET=

# ---------------------------------------------------------------------------
# CoinSwitch PRO  (https://api-trading.coinswitch.co)
# Options trading via API is PRIVATE BETA and allowlisted per API key.
# Request access: email api@coinswitch.co with your public API key.
# Auth is Ed25519: the secret is your base64-encoded Ed25519 private key.
# Market data for category=option also returns 401 until allowlisted.
# ---------------------------------------------------------------------------
COINSWITCH_BASE_URL=https://dma.coinswitch.co
COINSWITCH_API_KEY=
COINSWITCH_API_SECRET=
COINSWITCH_OPTIONS_ALLOWLISTED=false

# ---------------------------------------------------------------------------
# Feed behaviour
# ---------------------------------------------------------------------------
# auto (default): use a simulated book only for a side that is unavailable
# (e.g. CoinSwitch before allowlisting). Every quote is labelled live/simulated
# in the UI. Set to "false" to run strictly live and show gaps instead.
COINSWITCH_SIMULATED=auto

# Fallback spot if Delta's public ticker cannot be reached (simulator seeding).
DEMO_BTC_SPOT=74500
DEMO_ETH_SPOT=2080

# Assumed taker fee for the CoinSwitch leg until real contract specs are
# available for your account (fraction of premium, 0.0005 = 5 bps).
COINSWITCH_TAKER_FEE=0.0005

# Comma separated. Options outside these are ignored.
UNDERLYINGS=BTC,ETH

# Live reconciliation (used only when TRADING_MODE=live)
LIVE_SYNC_MS=3000
LIVE_POSITIONS_SYNC_MS=5000
